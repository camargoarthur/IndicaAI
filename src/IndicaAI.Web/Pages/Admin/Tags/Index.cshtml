@page
@model IndicaAI.Web.Pages.Admin.Tags.IndexModel
@{ViewData["Title"]=T["Administration"];}
<header class="page-heading"><div><p class="eyebrow">@T["Administration"]</p><h1>@T["Groups"] &amp; @T["Tags"]</h1><p>@T["GlobalTagsHint"]</p></div><a class="button" href="/Admin/Import/Preview">@T["ImportCsv"]</a></header><p><a href="/Admin/Associations">@T["AssociateTags"]</a></p>
@if(Model.ErrorCode is not null){<p class="alert" role="alert">@T.Get("error."+Model.ErrorCode,Model.ErrorArgs) @if(Model.ErrorCode=="linked_media"){<span>@string.Join(", ",Model.ErrorArgs)</span>}</p>}
<div class="list-grid"><section class="panel"><h2>@T["CreateGroup"]</h2><form method="post" class="inline-form" data-draft="group-new" data-version="0"><input name="OperationId" value="@Model.OperationId" type="hidden"/><input name="kind" value="group" type="hidden"/><label>@T["Name"]<input name="Name" value="@Model.Name" required maxlength="200"/></label><button>@T["Create"]</button></form></section><section class="panel"><h2>@T["CreateTag"]</h2><form method="post" data-draft="tag-new" data-version="0"><input asp-for="OperationId" type="hidden"/><label asp-for="Name">@T["Name"]<input asp-for="Name" required maxlength="200"/></label><label>@T["Group"]<select asp-for="GroupId" required><option value="">@T["Group"]</option>@foreach(var group in Model.Groups){<option value="@group.Id">@group.Name</option>}</select></label><fieldset><legend>@T["ApplicableMedia"]</legend>@foreach(var m in MediaCodes.All){<label class="check-line"><input type="checkbox" name="Applicable" value="@m" checked="@Model.Applicable.Contains(m)"/>@T["media."+m]</label>}</fieldset><button>@T["Create"]</button></form></section></div>
@foreach(var group in Model.Groups){<section class="panel"><h2>@group.Name</h2><p class="muted">ID: <code>@group.Id</code></p><details><summary>@T["Rename"]</summary><form method="post" class="inline-form" data-draft="group-@group.Id" data-version="@group.Version"><input name="kind" value="group" type="hidden"/><input name="OperationId" value="@Guid.NewGuid()" type="hidden"/><input name="Id" value="@group.Id" type="hidden"/><input name="Version" value="@group.Version" type="hidden"/><label>@T["Name"]<input name="Name" value="@group.Name" required/></label><button>@T["Save"]</button></form></details><div class="table-scroll"><table><thead><tr><th>@T["Tag"]</th><th>@T["ApplicableMedia"]</th><th>@T["Edit"]</th></tr></thead><tbody>@foreach(var tag in Model.Tags.Where(t=>t.GroupId==group.Id)){<tr><td><strong>@tag.Name</strong><br/><code>@tag.Id</code></td><td>@string.Join(", ",Model.Media.Where(m=>m.TagId==tag.Id).Select(m=>T["media."+m.MediaCode]))</td><td><details><summary>@T["Edit"]</summary><form method="post" data-draft="tag-@tag.Id" data-version="@tag.Version"><input name="OperationId" value="@Guid.NewGuid()" type="hidden"/><input name="Id" value="@tag.Id" type="hidden"/><input name="Version" value="@tag.Version" type="hidden"/><label>@T["Name"]<input name="Name" value="@tag.Name" required/></label><label>@T["Group"]<select name="GroupId">@foreach(var g in Model.Groups){<option value="@g.Id" selected="@(g.Id==tag.GroupId)">@g.Name</option>}</select></label>@foreach(var m in MediaCodes.All){<label class="check-line"><input name="Applicable" value="@m" type="checkbox" checked="@Model.Media.Any(x=>x.TagId==tag.Id&&x.MediaCode==m)"/>@T["media."+m]</label>}<button>@T["Save"]</button></form></details></td></tr>}</tbody></table></div></section>}

