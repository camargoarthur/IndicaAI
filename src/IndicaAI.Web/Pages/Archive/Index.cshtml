@page
@model IndicaAI.Web.Pages.Archive.IndexModel
@{ViewData["Title"]=T["Archived"];}
<header class="page-heading"><p class="eyebrow">@T["Collection"]</p><h1>@T["Archived"]</h1><p>@T["ArchiveConfirm"]</p></header>
@if(Model.ErrorCode is not null){<p class="alert" role="alert">@T["error."+Model.ErrorCode]</p>}
@if(Model.Items.Count==0){<div class="empty-state">@T["EmptyArchive"]</div>}
<div class="work-grid">@foreach(var item in Model.Items){<article class="work-card"><a asp-page="/Works/Details" asp-route-id="@item.Work.Id"><img src="/covers/@item.Work.CoverAsset" alt=""/><h2>@item.Work.Title</h2></a><p>@T["media."+item.Work.MediaCode]</p><form method="post" asp-page-handler="Set"><input name="operationId" value="@Guid.NewGuid()" type="hidden"/><input name="trackingId" value="@item.Tracking.Id" type="hidden"/><input name="version" value="@item.Tracking.Version" type="hidden"/><button class="secondary">@T["Restore"]</button></form></article>}</div>
