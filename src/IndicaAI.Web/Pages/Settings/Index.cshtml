@page
@model IndicaAI.Web.Pages.Settings.IndexModel
@{ViewData["Title"]=T["Preferences"];}
<header class="page-heading"><div><p class="eyebrow">IndicaAI</p><h1>@T["Preferences"]</h1><p>@T["PreferenceHint"]</p></div></header>
@if(Model.ErrorCode is not null){<p class="alert" role="alert">@T["error."+Model.ErrorCode]</p>}
@if(TempData["Notice"] is string message){<p class="notice success" role="status">@T[message]</p>}
<form method="post" class="panel settings-form" data-draft="preferences" data-version="@Model.Version"><input asp-for="Version" type="hidden"/><input asp-for="OperationId" type="hidden"/><label asp-for="Theme">@T["Appearance"]</label><select asp-for="Theme"><option value="light">@T["Light"]</option><option value="dark">@T["Dark"]</option></select><label asp-for="Locale">@T["Language"]</label><select asp-for="Locale">@foreach(var locale in LocaleRegistry.GetSupported()){<option value="@locale.Code">@locale.NativeName</option>}</select><button>@T["Save"]</button></form>
<h2 class="section-heading">@T["PersonalLabels"]</h2>
<div class="list-grid">
    @foreach (var media in MediaCodes.All)
    {
        var version = media == Model.EditedMedia ? Model.EditedVersion : Model.Version;
        <section class="panel" id="labels-@media">
            <h3 id="labels-heading-@media">@T["media." + media]</h3>
            <form method="post" data-draft="labels-@media" data-version="@version" asp-page-handler="Labels" aria-labelledby="labels-heading-@media">
                <input name="operationId" value="@Guid.NewGuid()" type="hidden" />
                <input name="version" value="@version" type="hidden" />
                <input name="media" value="@media" type="hidden" />
                @foreach (var code in MediaCodes.States)
                {
                    <div class="label-form">
                        <label id="label-@media-@code" for="value-@media-@code">@UiMessages.State(media, code, T.Locale)</label>
                        <input id="value-@media-@code" name="changes[@code]" value="@Model.LabelValue(media, code, T.Locale)" maxlength="100" />
                        @if (Model.Labels.ContainsKey(media + ":" + code) || Model.ResetSelected(media, code))
                        {
                            <label class="check-line">
                                <input type="checkbox" name="resetCodes" value="@code" checked="@Model.ResetSelected(media, code)" aria-labelledby="reset-@media-@code label-@media-@code" />
                                <span id="reset-@media-@code">@T["RestoreDefault"]</span>
                            </label>
                        }
                    </div>
                }
                <button type="submit">@T["SaveLabels"]</button>
            </form>
        </section>
    }
</div>

