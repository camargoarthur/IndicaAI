@using IndicaAI.Web.Features.Settings
@inject PreferenceService Preferences
@{var preference=await Preferences.GetAsync();var path=Context.Request.Path.Value??"";}
<!DOCTYPE html>
<html lang="@preference.Locale" data-theme="@preference.Theme" data-clear-selection-message="@T["ClearSelectionConfirm"]" data-draft-conflict="@T["DraftConflict"]" data-use-draft="@T["UseDraft"]" data-keep-current="@T["KeepCurrent"]" data-file-draft-message="@T["ResolveUploadBeforePreferences"]">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · IndicaAI</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><a class="skip-link" href="#main">@T["SkipContent"]</a>
<header class="site-header"><div class="masthead"><a href="/Library" class="wordmark">IndicaAI</a><span class="brand-subtitle">@T["EditorialCollection"]</span><nav aria-label="@T["Navigation"]">@foreach(var link in new[]{("/Library","Library"),("/Catalog","Catalog"),("/Lists","Lists"),("/Archive","Archived"),("/Admin/Tags","Administration")}){<a href="@link.Item1" class="@(path.StartsWith(link.Item1,StringComparison.OrdinalIgnoreCase)?"active":"")" aria-current="@(path.StartsWith(link.Item1,StringComparison.OrdinalIgnoreCase)?"page":null)">@T[link.Item2]</a>}</nav></div>
<div class="utility-row"><span class="local-label">@T["LocalCollection"]</span><form method="post" action="/Settings?handler=Quick" data-quick-preferences><input name="operationId" value="@Guid.NewGuid()" type="hidden"/><input name="version" value="@preference.Version" type="hidden"/><label><span class="sr-only">@T["Appearance"]</span><select name="theme"><option value="light" selected="@(preference.Theme=="light")">@T["Light"]</option><option value="dark" selected="@(preference.Theme=="dark")">@T["Dark"]</option></select></label><label><span class="sr-only">@T["Language"]</span><select name="locale">@foreach(var locale in LocaleRegistry.GetSupported()){<option value="@locale.Code" selected="@(preference.Locale==locale.Code)">@locale.NativeName</option>}</select></label>@Html.AntiForgeryToken()<noscript><button>@T["Save"]</button></noscript><a href="/Settings">@T["Preferences"]</a></form></div><p data-preference-error class="alert" role="alert" hidden>@T["error.save_failed"]</p></header>
<main id="main" class="page-shell">@RenderBody()</main><footer class="site-footer"><span>IndicaAI · @T["EditorialCollection"]</span><a asp-page="/Catalog/Tmdb" asp-fragment="tmdb-credits" aria-label="@T["TmdbCredits"]">TMDB</a><span>@T["LocalCollection"]</span></footer>
<script src="~/js/draft-model.js" asp-append-version="true" defer></script><script src="~/js/drafts.js" asp-append-version="true" defer></script><script src="~/js/selection.js" asp-append-version="true" defer></script><script src="~/js/preferences.js" asp-append-version="true" defer></script>@await RenderSectionAsync("Scripts",required:false)
</body></html>

