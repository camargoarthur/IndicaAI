@page
@model IndicaAI.Web.Pages.Works.HistoryModel
@{ViewData["Title"]=T["History"];}
<div class="history-layout">
 <aside class="history-sidebar">
  <a class="back-link" asp-page="/Works/Details" asp-route-id="@Model.Work.Id" asp-route-BrowseReturnUrl="@Model.SafeBrowseReturnUrl">@T["BackTracking"]</a>
  <h2>@Model.Work.Title</h2>
  <dl>
   <div><dt>@T["Media"]</dt><dd>@T["media."+Model.Work.MediaCode]</dd></div>
   <div><dt>@T["CurrentStatus"]</dt><dd><span class="state-badge">@T.CurrentState(Model.Work.MediaCode,Model.Tracking.StateCode)</span></dd></div>
   <div><dt>@T["CurrentCycle"]</dt><dd>@Model.Cycles.Last().Ordinal</dd></div>
   <div><dt>@T["AddedOn"]</dt><dd>@T.Date(Model.Tracking.IncludedOn)</dd></div>
  </dl>
  <a class="button" asp-page="/Works/NewCycle" asp-route-id="@Model.Id" asp-route-BrowseReturnUrl="@Model.SafeBrowseReturnUrl">@T["NewConsumption"]</a>
 </aside>
 <section>
  <h1 class="history-title">@T["History"]</h1>
  <div class="table-scroll">
   <table class="history-table">
    <thead><tr><th>@T["RecordedAt"]</th><th>@T["Event"]</th><th>@T["InformedDate"]</th></tr></thead>
    <tbody>
     @foreach(var e in Model.Events){
      <tr>
       <td>@T.Instant(e.RecordedAtUtc)</td>
       <td><strong>@T["event."+e.Type] · @T["Cycle"] @Model.Cycles.Single(c=>c.Id==e.CycleId).Ordinal</strong>
        @if(e.ToStateCode is not null){<p>@(e.FromStateCode is null?"":T.CurrentState(e.MediaCode,e.FromStateCode)+" → ")@T.CurrentState(e.MediaCode,e.ToStateCode)</p>}
        @if(e.Type=="date_corrected"){<p class="muted">@T["OriginalPreserved"]</p>}
       </td>
       <td>
        @if(e.Field is not null){
         <p>@T[e.Field=="start"?"StartDate":"CompletionDate"]: @(DateOnly.TryParse(e.OldValue,out var oldDate)?T.Date(oldDate):T["NoDate"]) → @(DateOnly.TryParse(e.NewValue,out var newDate)?T.Date(newDate):T["NoDate"])</p>
        }else if(e.NewValue is not null){
         using var dates=System.Text.Json.JsonDocument.Parse(e.NewValue);
         foreach(var property in dates.RootElement.EnumerateObject()){
          <p>@T[property.Name=="StartOn"?"StartDate":"CompletionDate"]: @(property.Value.ValueKind!=System.Text.Json.JsonValueKind.Null&&DateOnly.TryParse(property.Value.GetString(),out var d)?T.Date(d):T["NoDate"])</p>
         }
        }else{<span class="muted">—</span>}
       </td>
      </tr>
     }
    </tbody>
   </table>
  </div>
  <p class="history-reference help">@T.Get("DateReference",T.Date(Model.Tracking.IncludedOn)) @T["NoAutomaticCompletion"]</p>
  <details class="correction-form" open="@Model.OpenCorrection">
   <summary>@T["event.date_corrected"]</summary>
   @if (Model.ErrorCode is not null and not "unusual_dates") { <p class="notice error" role="alert" tabindex="-1">@T["error."+Model.ErrorCode]</p> }
   <form method="post" data-draft="date-@Model.Id" data-version="@Model.Version" asp-route-id="@Model.Id" asp-route-BrowseReturnUrl="@Model.SafeBrowseReturnUrl" data-tracking-dates data-history-date>
    <input asp-for="Version" type="hidden"/><input asp-for="OperationId" type="hidden"/>
    <input type="hidden" name="LoadedDateContext" value="@Model.SelectedDateContext" />
    <div class="date-grid">
     <div class="field">
      <label asp-for="CycleId">@T["Cycle"]</label>
      <select asp-for="CycleId" data-date-edit>
       @foreach(var c in Model.Cycles){
        <option value="@c.Id" data-start="@FormattableString.Invariant($"{c.StartOn:yyyy-MM-dd}")" data-completion="@FormattableString.Invariant($"{c.CompletionOn:yyyy-MM-dd}")">@T["Cycle"] @c.Ordinal</option>
       }
      </select>
     </div>
     <div class="field"><label asp-for="Field">@T["DateField"]</label><select asp-for="Field" data-date-edit><option value="start">@T["StartDate"]</option><option value="completion">@T["CompletionDate"]</option></select></div>
     <div class="field"><label asp-for="Value">@T["InformedDate"]</label><input asp-for="Value" type="date" asp-format="{0:yyyy-MM-dd}" data-date-edit /></div>
    </div>
    <partial name="_DateConfirmation" model="new DateConfirmation(Model.DateWarnings, Model.ExpectedDateConfirmationKey)" />
    <button type="submit">@T["Save"]</button>
    <button type="submit" name="ClearDate" value="true" class="text-button" formnovalidate hidden="@(Model.StoredDate is null)">@T["ClearDate"]</button>
   </form>
  </details>
 </section>
</div>

@section Scripts {
    <script src="~/js/tracking-dates.js" asp-append-version="true" defer></script>
    <script src="~/js/history-date.js" asp-append-version="true" defer></script>
}

