@page
@model IndicaAI.Web.Pages.Works.NewCycleModel
@{ViewData["Title"]=T["NewConsumption"];}
<a class="back-link" asp-page="Details" asp-route-id="@Model.Work.Id" asp-route-BrowseReturnUrl="@Model.OriginUrl">@Model.Work.Title</a><h1>@T["NewConsumption"]</h1><p class="intro">@T["NewCycleHint"]</p>
@if (Model.ErrorCode is not null and not "unusual_dates") { <div class="notice error" role="alert" tabindex="-1">@T["error."+Model.ErrorCode]</div> }
<form method="post" asp-route-id="@Model.Id" class="narrow-form" data-draft="cycle-@Model.Id" data-version="@Model.Input.Version" data-tracking-dates>
    <input asp-for="Input.OperationId" type="hidden" />
    <input asp-for="Input.Version" type="hidden" />
    @if (Model.OriginUrl is { } origin) { <input type="hidden" name="BrowseReturnUrl" value="@origin" /> }
    <div class="field">
        <label asp-for="Input.StateCode">@T["CurrentStatus"] *</label>
        <select asp-for="Input.StateCode" required data-date-state data-date-edit>
            <option value="">@T["ChooseStatus"]</option>
            @foreach (var code in MediaCodes.States)
            {
                <option value="@code" data-start="@TrackingDateForm.ShowsStart(code).ToString().ToLowerInvariant()" data-completion="@TrackingDateForm.ShowsCompletion(code).ToString().ToLowerInvariant()">@T.CurrentState(Model.Work.MediaCode, code)</option>
            }
        </select>
    </div>
    <partial name="_TrackingDates" model="new TrackingDateForm(Model.Input, Model.Tracking.IncludedOn, Model.DateWarnings)" />
    <noscript><button type="submit" class="secondary" asp-page-handler="Dates" asp-route-id="@Model.Id">@T["ShowStateDates"]</button></noscript>
    <div class="actions">
        <button class="button primary">@T["StartCycleAction"]</button>
        <a asp-page="Details" asp-route-id="@Model.Work.Id" asp-route-BrowseReturnUrl="@Model.OriginUrl">@T["Cancel"]</a>
    </div>
</form>

@section Scripts {
    <script src="~/js/tracking-dates.js" asp-append-version="true" defer></script>
}


